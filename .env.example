# Copy this file to .env for local `vercel dev` testing. On Vercel itself,
# set these as real Environment Variables in Project Settings — never commit
# actual values to this repo.

# From https://resend.com/api-keys — created after you sign up and verify
# your sending domain (pandasportsmemorabilia.com) in the Resend dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The ID of the Resend contact list signups get added to. Resend has been
# renaming "Audiences" to "Segments" in newer dashboards — same feature,
# create one either way and copy its ID here.
RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# Optional — where the "someone just signed up" notification email goes.
# Defaults to support@pandasportsmemorabilia.com if you don't set this.
RESEND_NOTIFY_TO=support@pandasportsmemorabilia.com

# Optional — the From address on that notification email. info@ is the
# convention this site uses for anything automated the system sends;
# support@ is where a human reads replies. The domain part must be verified
# in Resend. Defaults to the value shown here if unset.
RESEND_FROM=Panda Sports Memorabilia <info@pandasportsmemorabilia.com>
